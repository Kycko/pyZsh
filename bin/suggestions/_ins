#compdef ins

# Подменяем имя команды с 'ins' на 'yay'
words[1]=yay

# Добавляем флаг '-S' в массив аргументов вторым элементом
words=(yay -S "${words[@]:1}")

# Сдвигаем указатель текущего слова, так как массив увеличился на один элемент
(( CURRENT++ ))

# Временно перезаписываем служебную переменную Zsh, чтобы она думала, что дополняет 'yay'
local service=yay

# Вызываем оригинальное автодополнение yay
_yay
