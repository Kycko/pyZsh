#compdef ins

_ins() {
  local cacheFile="${_pzGlobals[pkgCache]}"
  local -a pkgs

  if [[ -f "${cacheFile}" ]]
    then
      # основной путь для обеих систем: читаем кэш из Python
      pkgs=(${(f)"$(cat "${cacheFile}")"})
    else
      # фоллбэк на случай, если файл кеша отсутствует
      if [[ "${_pzGlobals[isArch]}" == "True" ]]
        then pkgs=(${(f)"$(pacman -Slq 2>/dev/null)"})
        else _dnf install && return 0
      fi
  fi

  compadd -a pkgs # единая точка вывода вариантов
}
