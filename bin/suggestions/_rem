#compdef rem

_rem() {
  if [[ "${_pzGlobals[isArch]}" == "True" ]]; then
    # быстро и безопасно собираем все локально установленные пакеты в массив
    local -a installed_pkgs
    installed_pkgs=(${(f)"$(pacman -Qq 2>/dev/null)"})

    # скармливаем массив Zsh
    compadd -a installed_pkgs
  else
    local -a dnf_installed
    dnf_installed=(${(f)"$(rpm -qa --qf "%{NAME}\n" 2>/dev/null)"})
    compadd -a dnf_installed
  fi
}
