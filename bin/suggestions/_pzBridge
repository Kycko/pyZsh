# единый мост автодополнения для всех python-скриптов pyZsh

_pzBridge() {
  ####################### стандартный запуск
  # 1. $words[1] содержит имя вызываемой функции (например, 'ins' или 'rem')
  local cmdName="$words[1]"
  
  # 2. Проверяем, существует ли вообще такая Zsh-функция в памяти
  if (( $+functions[${cmdName}] )) ; then
    local -a final

    # 3. Вызываем функцию напрямую, добавляя флаг и текущее вводимое слово
    final=(${(f)"$(${words} --zsh-data 2>/dev/null)"})


    ####################### обработка разных вариантов
    case "${final}" in
      _path) _files ;;
      # ↓ если маркер не совпал, проваливаемся дальше к _describe
      *)     false  ;;
    # ↓ return сработает, только если любое условие выполнено
    # ↓ завершаем работу: сам final не выводим
    esac && return 0


    ####################### финальный вывод
    # 4. Отображаем полученные от Python варианты
    if (( ${#final} > 0 )); then
      # Если в строках есть пробелы вокруг двоеточия, Zsh может спотыкаться.
      # Чтобы подставлялось 'search', а не 'search file', мы говорим _describe,
      # что перед нами список команд, и он сам сделает красивую колонку описаний.
      _describe -t commands "варианты ${cmdName}" final
    fi
  fi
}
